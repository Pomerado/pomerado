{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "include": [
    "typescript/src/**/*.ts",
    "typescript/authoring/examples/**/*.ts",
    "typescript/tests/browser/authoring-fixture.ts",
    "typescript/tests/browser/autofill-date-fixture.ts",
    "typescript/tests/support/canary.ts",
    "typescript/tests/support/credential-masking-corpus.ts",
    "typescript/tests/support/expect-failure.ts",
    "typescript/tests/support/kernel-run.ts",
    "typescript/tests/browser/isolated-locator-page.ts",
    "typescript/tests/support/job-store-contract.ts",
    "typescript/tests/support/mint-fixtures.ts",
    "typescript/tests/browser/shop-fixture.ts",
    "typescript/tests/support/tenant-policy.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
